{
  "name": "leetscope",
  "version": "0.3.0",
  "description": "LeetScope: step-by-step visualizations of Python LeetCode solutions, as a Chrome extension",
  "scripts": {
    "build:extension": "node scripts/build-extension.mjs",
    "build:extension-test": "node scripts/build-extension.mjs --test",
    "test": "node --test tests/",
    "acceptance": "node scripts/acceptance.mjs",
    "stress": "node scripts/stress.mjs",
    "verify:db": "node scripts/verify-db.mjs",
    "check:calls": "node scripts/check-calls.mjs",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build:baseline": "node scripts/build-renderer.mjs --baseline",
    "bench:serve": "node scripts/serve-bench.mjs"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "esbuild": "0.28.2",
    "puppeteer-core": "25.17.0",
    "pyodide": "314.0.8"
  },
  "private": true
}
