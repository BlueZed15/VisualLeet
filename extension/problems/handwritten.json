    },
    "meeting-rooms-ii": {
      "kind": "template",
      "boxes": [{ "name": "intervals", "type": "integer[][]" }],
      "helpers": [],
      "setup": "intervals = {intervals}",
      "visible": ["intervals"],
      "call": "result = Solution().minMeetingRooms(intervals)\nprint(leet_str(result))",
