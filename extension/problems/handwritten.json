      "boxes": [{ "name": "intervals", "type": "integer[][]" }],
      "helpers": [],
      "setup": "intervals = {intervals}",
      "visible": ["intervals"],
      "call": "result = Solution().canAttendMeetings(intervals)\nprint(leet_str(result))",
