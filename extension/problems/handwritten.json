{
  "about": "Hand-written setups for problems whose test input doesn't match the function's parameters (LeetCode marks them \"manual\"). {name} is replaced by that box's value as Python. Checked by scripts/verify-db.mjs against the examples in tests below.",
  "problems": {
    "linked-list-cycle": {
      "kind": "template",
      "boxes": [
        { "name": "head", "type": "integer[]", "label": "head" },
        { "name": "pos", "type": "integer", "label": "pos", "hint": "index the tail links back to; -1 means no cycle" }
      ],
      "helpers": ["CycleList"],
      "setup": "head = build_cycle_list({head}, {pos})",
      "visible": ["head"],
      "call": "result = Solution().hasCycle(head)\nprint(leet_str(result))",
      "tests": [["[3,2,0,-4]\n1", "true"], ["[1,2]\n0", "true"], ["[1]\n-1", "false"]]
    },
    "copy-list-with-random-pointer": {
      "kind": "template",
      "boxes": [{ "name": "head", "type": "list<list<integer?>>", "label": "head", "hint": "[value, index of the random node or null] per node" }],
      "helpers": ["RandomList"],
      "setup": "head = build_random_list({head})",
      "visible": ["head"],
      "call": "result = Solution().copyRandomList(head)\nprint(leet_str(random_list_values(result)))",
      "tests": [["[[7,null],[13,0],[11,4],[10,2],[1,0]]", "[[7,null],[13,0],[11,4],[10,2],[1,0]]"], ["[[1,1],[2,1]]", "[[1,1],[2,1]]"], ["[[3,null],[3,0],[3,null]]", "[[3,null],[3,0],[3,null]]"]]
    },
    "clone-graph": {
      "kind": "template",
      "boxes": [{ "name": "adjList", "type": "integer[][]", "label": "adjList", "hint": "neighbors of node 1, 2, 3, …" }],
      "helpers": ["Graph"],
      "setup": "node = build_graph({adjList})",
      "visible": ["node"],
      "call": "result = Solution().cloneGraph(node)\nprint(leet_str(graph_values(result)))",
      "tests": [["[[2,4],[1,3],[2,4],[1,3]]", "[[2,4],[1,3],[2,4],[1,3]]"], ["[[]]", "[[]]"], ["[]", "[]"]]
    },
    "lowest-common-ancestor-of-a-binary-search-tree": {
      "kind": "template",
      "boxes": [
        { "name": "root", "type": "TreeNode", "label": "root" },
        { "name": "p", "type": "integer", "label": "p", "hint": "value of a node in the tree" },
        { "name": "q", "type": "integer", "label": "q", "hint": "value of a node in the tree" }
      ],
      "helpers": [],
      "setup": "root = {root}\np = find_node(root, {p})\nq = find_node(root, {q})",
      "visible": ["root", "p", "q"],
      "call": "result = Solution().lowestCommonAncestor(root, p, q)\nprint(leet_str(result.val if result else None))",
      "tests": [["[6,2,8,0,4,7,9,null,null,3,5]\n2\n8", "6"], ["[6,2,8,0,4,7,9,null,null,3,5]\n2\n4", "2"], ["[2,1]\n2\n1", "2"]]
    },
    "serialize-and-deserialize-binary-tree": {
      "kind": "template",
      "boxes": [{ "name": "root", "type": "TreeNode", "label": "root" }],
      "helpers": [],
      "setup": "root = {root}",
      "visible": ["root"],
      "call": "ser = Codec()\ndeser = Codec()\nresult = deser.deserialize(ser.serialize(root))\nprint(leet_str(tree_values(result)))",
      "tests": [["[1,2,3,null,null,4,5]", "[1,2,3,null,null,4,5]"], ["[]", "[]"]]
    },
    "encode-and-decode-strings": {
      "kind": "template",
      "boxes": [{ "name": "strs", "type": "string[]", "label": "strs" }],
      "helpers": [],
      "setup": "strs = {strs}",
      "visible": ["strs"],
      "call": "codec = Codec()\nresult = codec.decode(codec.encode(strs))\nprint(leet_str(result))",
      "title": "Encode and Decode Strings", "frontendId": "271", "premium": true,
      "tests": [["[\"Hello\",\"World\"]", "[\"Hello\",\"World\"]"], ["[\"\"]", "[\"\"]"]]
    },
    "number-of-islands": {
      "kind": "template",
      "boxes": [{ "name": "grid", "type": "character[][]" }],
      "helpers": [],
      "setup": "grid = {grid}",
      "visible": ["grid"],
      "call": "result = Solution().numIslands(grid)\nprint(leet_str(result))",
      "note": "LeetCode marks it manual (for other languages); in Python the input is the parameter.",
      "tests": "collected"
    },
    "walls-and-gates": {
      "kind": "template",
      "boxes": [{ "name": "rooms", "type": "integer[][]", "hint": "-1 wall, 0 gate, 2147483647 empty room" }],
      "helpers": [],
      "setup": "rooms = {rooms}",
      "visible": ["rooms"],
      "call": "Solution().wallsAndGates(rooms)\nprint(leet_str(rooms))",
      "title": "Walls and Gates", "frontendId": "286", "premium": true,
      "tests": [["[[2147483647,-1,0,2147483647],[2147483647,2147483647,2147483647,-1],[2147483647,-1,2147483647,-1],[0,-1,2147483647,2147483647]]", "[[3,-1,0,1],[2,2,1,-1],[1,-1,2,-1],[0,-1,3,4]]"], ["[[-1]]", "[[-1]]"]]
    },
    "graph-valid-tree": {
      "kind": "template",
      "boxes": [{ "name": "n", "type": "integer" }, { "name": "edges", "type": "integer[][]" }],
      "helpers": [],
      "setup": "n = {n}\nedges = {edges}",
      "visible": ["n", "edges"],
      "call": "result = Solution().validTree(n, edges)\nprint(leet_str(result))",
      "title": "Graph Valid Tree", "frontendId": "261", "premium": true,
      "tests": [["5\n[[0,1],[0,2],[0,3],[1,4]]", "true"], ["5\n[[0,1],[1,2],[2,3],[1,3],[1,4]]", "false"]]
    },
    "number-of-connected-components-in-an-undirected-graph": {
      "kind": "template",
      "boxes": [{ "name": "n", "type": "integer" }, { "name": "edges", "type": "integer[][]" }],
      "helpers": [],
      "setup": "n = {n}\nedges = {edges}",
      "visible": ["n", "edges"],
      "call": "result = Solution().countComponents(n, edges)\nprint(leet_str(result))",
      "title": "Number of Connected Components in an Undirected Graph", "frontendId": "323", "premium": true,
      "tests": [["5\n[[0,1],[1,2],[3,4]]", "2"], ["5\n[[0,1],[1,2],[2,3],[3,4]]", "1"]]
    },
    "alien-dictionary": {
      "kind": "template",
      "boxes": [{ "name": "words", "type": "string[]" }],
      "helpers": [],
      "setup": "words = {words}",
